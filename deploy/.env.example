# Copy to deploy/.env (never commit it) and fill in.
# Domain that points to this server (an A record); the app connects to wss://<DOMAIN>/ws.
DOMAIN=chess.4vic.ru
# Long random password, for example from: openssl rand -base64 32
DB_PASSWORD=
# Computer opponent when no person is found within BOT_WAIT_SECONDS (plus up to 6 s); "off" disables it.
BOT_OPPONENTS=on
BOT_WAIT_SECONDS=8
