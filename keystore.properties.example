# Copy to keystore.properties (ignored by git) to sign release builds:
#   ./gradlew :androidApp:bundlePlayRelease :androidApp:assembleRustoreRelease
# Create the upload key once and keep it and the passwords safe (a password manager plus an offline copy):
#   keytool -genkeypair -v -keystore upload-key.jks -alias upload -keyalg RSA -keysize 4096 -validity 10000
# Google Play: enrol in Play App Signing and upload builds signed with this upload key.
# RuStore: the same key signs the APK; RuStore keeps the signature, so never lose this key.
storeFile=upload-key.jks
storePassword=
keyAlias=upload
keyPassword=
